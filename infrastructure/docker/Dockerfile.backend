# Multi-Stage Dockerfile for PrivyChat Spring Boot Backend
FROM maven:3.9.9-eclipse-temurin-21 AS builder
WORKDIR /workspace

# Cache Maven dependencies
COPY backend/pom.xml .
RUN mvn dependency:go-offline -B

# Copy backend source code and build executable jar
COPY backend/src ./src
RUN mvn clean package -DskipTests -B

# Production Runtime Stage
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app

# Create unprivileged user for security
RUN addgroup -S privychat && adduser -S privychat -G privychat

# Copy compiled JAR from builder stage
COPY --from=builder /workspace/target/backend-1.0.0.jar app.jar

# Configuration and attachments directory
RUN mkdir -p /app/storage /app/logs && chown -R privychat:privychat /app

USER privychat

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:8080/actuator/health || exit 1

ENTRYPOINT ["java", "-XX:+UseG1GC", "-XX:MaxRAMPercentage=75.0", "-Djava.security.egd=file:/dev/./urandom", "-jar", "app.jar"]

