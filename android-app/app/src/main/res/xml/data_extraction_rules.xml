<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Exclude all cloud and local backups to prevent forensic extraction of private keys and chats -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>

