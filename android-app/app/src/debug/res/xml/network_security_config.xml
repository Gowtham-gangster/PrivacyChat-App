<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- By default, disallow all cleartext HTTP traffic across the app -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
      DEBUG BUILDS ONLY:
      Allow cleartext HTTP traffic to local emulator loopback and the AWS Elastic Beanstalk
      HTTP test deployment (privychat-env.eba-cj3jjvij.ap-south-1.elasticbeanstalk.com).

      IMPORTANT: Release builds use src/main/res/xml/network_security_config.xml where
      remote cleartext HTTP is strictly forbidden. HTTPS/WSS must be configured on AWS
      (e.g., via AWS ACM and an Application Load Balancer or CloudFront) before production release.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="true">privychat-env.eba-cj3jjvij.ap-south-1.elasticbeanstalk.com</domain>
    </domain-config>
</network-security-config>

