# ==============================================================================
# PrivyChat Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL CREDENTIALS TO SOURCE CONTROL
# ==============================================================================

# Application & Server
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080
APK_DOWNLOAD_URL=https://privychat.example.com/download/privychat-release.apk
ALLOWED_APP_ORIGINS=http://localhost:3000,http://localhost:8080

# Database (PostgreSQL / Supabase Postgres)
DATABASE_URL=jdbc:postgresql://localhost:5432/privychat
DATABASE_USERNAME=privychat_user
DATABASE_PASSWORD=replace_with_strong_password
DATABASE_POOL_SIZE=20

# JWT & Authentication
JWT_SECRET=replace_with_at_least_256_bit_random_secret_base64_encoded_minimum_32_bytes
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30
AUTH_ISSUER=https://privychat.example.com
AUTH_AUDIENCE=privychat-client

# Email Delivery (SMTP Only - Used for all Account & Verification Communications)
# Configured via Spring Boot JavaMailSender (Supports Gmail, SendGrid, Mailgun, Amazon SES, Mailtrap)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=replace_with_your_email@gmail.com
SPRING_MAIL_PASSWORD=replace_with_app_password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
PRIVYCHAT_MAIL_FROM=replace_with_your_email@gmail.com
PRIVYCHAT_MAIL_FROM_NAME=PrivyChat Security

# Legacy SMTP Alias Fallbacks (Supported for backward compatibility)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_your_email@gmail.com
SMTP_PASSWORD=replace_with_app_password
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
MAIL_FROM_ADDRESS=replace_with_your_email@gmail.com
MAIL_FROM_NAME=PrivyChat Security

# Push Notifications (Firebase Cloud Messaging)
FCM_ENABLED=false
FCM_PROJECT_ID=privychat-production
FCM_CREDENTIALS_PATH=config/firebase-service-account.json

# Encrypted Object Storage (Supabase Storage / Local)
STORAGE_TYPE=supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
SUPABASE_BUCKET_NAME=privychat-attachments
SUPABASE_SIGNED_URL_EXPIRATION=300
STORAGE_LOCAL_DIR=./storage-attachments

# WebRTC STUN / TURN Infrastructure
STUN_SERVER_URL=stun:stun.l.google.com:19302
COTURN_ENABLED=false
COTURN_HOST=
COTURN_PORT=3478
COTURN_TLS_PORT=5349
COTURN_REALM=privychat.app
COTURN_STATIC_SECRET=generate_secure_random_64_char_hex_token
COTURN_TTL_SECONDS=86400

# Rate Limiting & Abuse Prevention
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_HOUR=3
RATE_LIMIT_OTP_REQUEST_PER_HOUR=5
RATE_LIMIT_MESSAGE_PER_SECOND=20

# Android Release Signing Keystore (Optional)
KEYSTORE_PATH=android-app/app/privychat-release.keystore
KEYSTORE_PASSWORD=privychat_password
KEY_ALIAS=privychat
KEY_PASSWORD=privychat_password
