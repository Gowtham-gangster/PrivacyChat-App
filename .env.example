# ==============================================================================
# PrivyChat Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL CREDENTIALS TO SOURCE CONTROL
# ==============================================================================

# Application & Server
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080
APK_DOWNLOAD_URL=https://privychat.example.com/download/privychat-release.apk
ALLOWED_APP_ORIGINS=http://localhost:3000,http://localhost:8080

# Database (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/privychat
DATABASE_USERNAME=privychat_user
DATABASE_PASSWORD=replace_with_strong_password
DATABASE_POOL_SIZE=20

# JWT & Authentication
JWT_SECRET=replace_with_at_least_256_bit_random_secret_base64_encoded_minimum_32_bytes
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30
AUTH_ISSUER=https://privychat.example.com
AUTH_AUDIENCE=privychat-client

# Email Delivery (SMTP / Transactional)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
MAIL_FROM_ADDRESS=noreply@privychat.example.com
MAIL_FROM_NAME=PrivyChat Security

# SMS Gateway (Twilio / AWS SNS / Infobip / Dev Mock)
SMS_PROVIDER=dev
SMS_API_KEY=replace_with_sms_provider_api_key
SMS_SENDER_ID=PrivyChat

# Push Notifications (Firebase Cloud Messaging)
FCM_ENABLED=false
FCM_PROJECT_ID=privychat-production
FCM_CREDENTIALS_PATH=/etc/privychat/firebase-adminsdk.json

# Encrypted Object Storage (MinIO / AWS S3)
STORAGE_TYPE=s3
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=privychat-encrypted-attachments
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_PATH_STYLE=true

# WebRTC STUN / TURN Infrastructure
TURN_SERVER_URL=turn:turn.privychat.example.com:3478
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_USERNAME=privychat_turn_user
TURN_SERVER_CREDENTIAL=replace_with_turn_server_secret

# Rate Limiting & Abuse Prevention
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_HOUR=3
RATE_LIMIT_OTP_REQUEST_PER_HOUR=5
RATE_LIMIT_MESSAGE_PER_SECOND=20

